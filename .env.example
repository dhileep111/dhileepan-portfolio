# Production URL. Optional on Netlify (it falls back to the site's main address, Netlify's
# built-in URL variable); set it explicitly once you choose a custom domain.
NEXT_PUBLIC_SITE_URL=

# Optional: overrides the Formspree endpoint set in src/content/site.ts.
NEXT_PUBLIC_FORM_ENDPOINT=

# Free site-check tool (/tools/site-check). Server-side only: never prefix with NEXT_PUBLIC_.
# Create at console.cloud.google.com: enable "PageSpeed Insights API", then Credentials > API key.
PAGESPEED_API_KEY=

# Optional but recommended: makes the per-visitor rate limit hold across serverless instances.
# Free Upstash Redis database (upstash.com).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
