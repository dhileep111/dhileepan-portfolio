# REQUIRED for production builds: your real public URL (no trailing slash).
# GitHub Pages project site: https://<username>.github.io/<repo>
# Custom domain:             https://yourdomain.com
NEXT_PUBLIC_SITE_URL=

# Only for GitHub Pages project sites served from /<repo> (leave empty for a custom domain).
NEXT_PUBLIC_BASE_PATH=

# Optional: form endpoint (Formspree, Basin, Getform...). The contact form POSTs JSON here.
# If unset, the form falls back to opening the visitor's email app (needs contact.email).
NEXT_PUBLIC_FORM_ENDPOINT=
